<Window x:Class="ЗаданиеЮшкова.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ЗаданиеЮшкова"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Список заявок"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Фильтры -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="FilterStatus" Width="120" Margin="0,0,15,0">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="New"/>
                <ComboBoxItem Content="InProgress"/>
                <ComboBoxItem Content="Resolved"/>
                <ComboBoxItem Content="Closed"/>
                <ComboBoxItem Content="Cancelled"/>
            </ComboBox>

            <TextBlock Text="Приоритет:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="FilterPriority" Width="120" Margin="0,0,15,0">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="Low"/>
                <ComboBoxItem Content="Normal"/>
                <ComboBoxItem Content="High"/>
                <ComboBoxItem Content="Critical"/>
            </ComboBox>

            <Button Content="Применить" Width="100" Click="ApplyFilter_Click"/>
        </StackPanel>

        <!-- Таблица заявок -->
        <DataGrid Grid.Row="2" x:Name="TicketsGrid"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"         Binding="{Binding Id}"         Width="50"/>
                <DataGridTextColumn Header="Заголовок"  Binding="{Binding Title}"      Width="*"/>
                <DataGridTextColumn Header="Приоритет"  Binding="{Binding Priority}"   Width="100"/>
                <DataGridTextColumn Header="Статус"     Binding="{Binding Status}"     Width="110"/>
                <DataGridTextColumn Header="Создана"    Binding="{Binding CreatedAt}"  Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Создать"        Width="120" Margin="0,0,10,0" Click="Create_Click"/>
            <Button Content="Изменить"       Width="120" Margin="0,0,10,0" Click="Edit_Click"/>
            <Button Content="Сменить статус" Width="140" Margin="0,0,10,0" Click="ChangeStatus_Click"/>
            <Button Content="Отчёты"         Width="120" Click="Reports_Click"/>
        </StackPanel>
    </Grid>
</Window>
